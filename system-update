#!/usr/bin/env bash
set -uo pipefail

AUTO=0
REPAIR=0
CHECK=0
HELP=0
for a in "$@"; do
  case "$a" in
    --auto)   AUTO=1 ;;
    --repair) REPAIR=1 ;;
    --check)  CHECK=1 ;;
    --help|-h) HELP=1 ;;
    *)
      echo "Unknown option: $a" >&2
      echo "Try 'system-update --help' for usage." >&2
      exit 1
      ;;
  esac
done

if [ "$HELP" -eq 1 ]; then
  cat <<'EOF'
Usage: system-update [options]

  --auto     run unattended, no prompts (for timers/scripts)
  --check    only report available updates, change nothing
  --repair   additionally deep-verify Flatpak installs
  --help     show this help

Logs are appended to ~/.local/state/system-update.log (rotated at 1MB).
EOF
  exit 0
fi

LOCK="$HOME/.local/state/system-update.lock"
exec 9>"$LOCK"
if ! flock -n 9; then
  echo "Another system update is already running — aborting."
  exit 1
fi

LOG="$HOME/.local/state/system-update.log"
mkdir -p "$(dirname "$LOG")"

if [ -f "$LOG" ] && [ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt 1048576 ]; then
  mv -f "$LOG" "$LOG.old" 2>/dev/null
  : > "$LOG"
fi

exec > >(tee >(sed -E 's/\x1B\[[0-9;]*[mK]//g' >> "$LOG")) 2>&1

start=$(date +%s)
FAILED=0

log()  { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
ok()   { printf '  \033[1;32m✔ %s\033[0m\n' "$*"; }
bad()  { printf '  \033[1;31m✘ %s\033[0m\n' "$*"; }
warn() { printf '  \033[1;33m⚠ %s\033[0m\n' "$*"; }

report() {
  local name="$1" status="$2"
  if [ "$status" -eq 0 ]; then
    ok "$name"
  else
    bad "$name (exit $status)"
    FAILED=$((FAILED + 1))
  fi
}

deployment() {
  rpm-ostree status --json 2>/dev/null \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)["deployments"][0]["checksum"])' 2>/dev/null \
    || echo none
}

deployment_info() {
  rpm-ostree status --json 2>/dev/null | python3 -c "
import json,sys
try:
    deps = json.load(sys.stdin)['deployments']
except Exception:
    print('  (no deployment info)')
    sys.exit(0)
if not deps:
    print('  (no deployments)')
    sys.exit(0)
for d in deps:
    m = d.get('base-commit-meta', {})
    tag = 'booted' if d.get('booted') else ('staged' if d.get('staged') else 'older ')
    print('  {} version={} kernel={} {}'.format(tag, m.get('version','?'), m.get('ostree.linux','?'), d.get('checksum','')[:12]))
"
}

check_mount() {
  local p="$1" min_mib="$2"
  local avail_raw
  avail_raw=$(df -P "$p" 2>/dev/null | awk 'NR==2 {print $4}')
  if [ -z "$avail_raw" ]; then
    bad "cannot read disk info for $p"
    need=1
    return
  fi
  local avail=$(( avail_raw / 1024 ))
  if [ "$avail" -lt "$min_mib" ]; then
    bad "Low disk on $p: ${avail} MiB free"
    need=1
  else
    ok "$p: $(( avail / 1024 )) GiB free"
  fi
}

echo "========================================"
echo "          SYSTEM UPDATE"
echo "========================================"
date
[ -f /run/systemd/reboot-required ] && warn "systemd reports a reboot is required"
printf '  Secure Boot: %s\n' "$(mokutil --sb-state 2>/dev/null | grep -oE "SecureBoot (enabled|disabled)" || echo unknown)"
printf '  SELinux: %s\n' "$(getenforce 2>/dev/null || echo unknown)"
printf '  Boot time: %s\n' "$(systemd-analyze time 2>/dev/null | grep -oP 'Startup finished in .*' | sed 's/Startup finished in //')"
printf '  Running kernel: %s\n' "$(uname -r)"
sysstate=$(systemctl is-system-running 2>/dev/null)
[ -z "$sysstate" ] && sysstate="unknown"
if [ "$sysstate" = "running" ]; then
  printf '  System state: %s\n' "$sysstate"
else
  warn "system state: $sysstate (see failed units below)"
fi

log "Current deployments"
deployment_info

log "Checking network"
if ip route 2>/dev/null | grep -q '^default'; then
  ok "network available"
else
  warn "no default route — aborting (updates need the network)"
  exit 1
fi

if [ "$CHECK" -eq 1 ]; then
  [ "$REPAIR" -eq 1 ] && warn "note: --repair is ignored in --check mode"
  log "Checking for available updates (--check)"
  os_out=$(rpm-ostree upgrade --check 2>&1)
  if echo "$os_out" | grep -qi 'no updates available'; then
    os_avail="none"
  else
    os_avail=$(echo "$os_out" | grep -iEo 'version[ =]+[0-9][0-9a-zA-Z._-]*' | head -1 | grep -oE '[0-9][0-9a-zA-Z._-]*')
    os_avail="${os_avail:-yes}"
  fi
  fp_avail=$(flatpak remote-ls --updates 2>/dev/null | grep -c . )
  fw_avail=$(fwupdmgr get-updates 2>/dev/null | grep -c '•' )
  printf '  OS: %s\n' "$os_avail"
  printf '  Flatpak: %s pending\n' "$fp_avail"
  printf '  Firmware: %s pending\n' "$fw_avail"
  if command -v notify-send >/dev/null 2>&1; then
    if [ "$os_avail" = "none" ] && [ "$fp_avail" -eq 0 ] && [ "$fw_avail" -eq 0 ]; then
      notify-send -a "System Update" -u normal "Update check" "Everything is up to date" 2>/dev/null
    else
      notify-send -a "System Update" -u normal "Update check" "Updates available — OS: $os_avail | Flatpak: $fp_avail | Firmware: $fw_avail" 2>/dev/null
    fi
  fi
  echo
  [ "$AUTO" -eq 0 ] && [ -t 0 ] && read -rp 'Press Enter to close...' _
  exit 0
fi

log "Checking clock sync"
if [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" = "yes" ]; then
  ok "NTP clock synced"
else
  warn "NTP clock not synced — updates may fail"
fi

log "Checking failed services"
failed=$(systemctl list-units --failed --no-legend --no-pager --plain 2>/dev/null | awk 'NF {print $1}' | paste -sd ', ' -)
if [ -n "$failed" ]; then
  warn "failed units: $failed"
else
  ok "no failed units"
fi

log "Checking journal errors since boot"
jerrs=$(journalctl -b -p err --no-pager --no-hostname 2>/dev/null)
jcount=$(printf '%s\n' "$jerrs" | grep -c . )
if [ "$jcount" -gt 0 ]; then
  warn "$jcount error-level journal entries since boot (last 3:)"
  printf '%s\n' "$jerrs" | tail -3 | sed 's/^/    /'
else
  ok "no error-level journal entries"
fi

log "Checking flatpak repo health"
remotes_ok=0
if flatpak remotes --columns=name 2>/dev/null | grep -q .; then
  remotes_ok=1
  runtimes=$(flatpak list --runtime 2>/dev/null | grep -c .)
  apps=$(flatpak list --app 2>/dev/null | grep -c .)
  ok "remotes: $(flatpak remotes --columns=name 2>/dev/null | paste -sd ', ' -) ($apps apps, $runtimes runtimes)"
else
  warn "no flatpak remotes configured"
fi

log "Checking disk space"
need=0
check_mount /var 5120
check_mount "$HOME" 5120
check_mount /boot 100
[ "$need" -ne 0 ] && warn "Aborting — resolve the disk issues above first." && exit 1

can_fwupdate=1
for bat in /sys/class/power_supply/BAT*; do
  [ -d "$bat" ] || continue
  cap=$(cat "$bat/capacity" 2>/dev/null || echo 0)
  status=$(cat "$bat/status" 2>/dev/null || echo Unknown)
  if [ "$status" != "Charging" ] && [ "$status" != "Full" ] && [ "$cap" -lt 30 ]; then
    warn "on battery (${cap}%) — skipping firmware update"
    can_fwupdate=0
  fi
done

if [ "$can_fwupdate" -eq 1 ]; then
  log "Refreshing firmware metadata"
  fwupdmgr refresh 2>/dev/null
  rc=$?
  [ "$rc" -eq 2 ] && rc=0
  report "firmware metadata" $rc

  fw_count=$(fwupdmgr get-updates 2>/dev/null | grep -c '•' )
  if [ "$fw_count" -gt 0 ]; then
    ok "$fw_count firmware updates available"
  else
    ok "no firmware updates available"
  fi

  log "Updating firmware"
  fwupdmgr update -y --no-reboot-check 2>/dev/null
  report "firmware" $?

  log "Checking pending firmware activation"
  if fwupdmgr check-reboot-needed >/dev/null 2>&1; then
    ok "no firmware reboot pending"
  else
    warn "firmware update needs a reboot"
  fi
else
  warn "firmware checks skipped (battery)"
fi

if [ "$remotes_ok" -eq 1 ]; then
  log "Refreshing Flatpak app metadata"
  flatpak update --appstream -y 2>/dev/null
  report "appstream" $?

  log "Updating Flatpak apps"
  flatpak update -y 2>/dev/null
  report "flatpak update" $?

  if [ "$REPAIR" -eq 1 ]; then
    log "Deep-verifying Flatpak installs (--repair)"
    flatpak repair 2>/dev/null
    report "flatpak repair" $?
  fi

  log "Cleaning orphaned Flatpak runtimes"
  flatpak uninstall --unused -y 2>/dev/null
  report "flatpak cleanup" $?
else
  warn "skipping flatpak steps — no remotes configured"
fi

log "Updating system (rpm-ostree)"
before=$(deployment)
pkexec sh -c 'rpm-ostree refresh-md && rpm-ostree update && rpm-ostree cleanup -r'
report "rpm-ostree update" $?
after=$(deployment)

reboot_needed=0
[ "$after" != "none" ] && [ "$before" != "$after" ] && reboot_needed=1

echo
echo "----------------------------------------"
if [ "$FAILED" -gt 0 ]; then
  warn "$FAILED step(s) failed — see the log."
elif [ "$reboot_needed" -eq 1 ]; then
  warn "A new system deployment is ready — reboot to apply it."
  printf '\nNew deployment:\n'; deployment_info
  printf 'Rollback if something breaks:  rpm-ostree rollback\n'
  run_kernel=$(uname -r)
  new_kernel=$(rpm-ostree status --json 2>/dev/null | python3 -c 'import json,sys
for d in json.load(sys.stdin)["deployments"]:
    if d.get("staged") or d.get("booted"):
        print(d.get("base-commit-meta",{}).get("ostree.linux","?")); break' 2>/dev/null)
  if [ -n "$new_kernel" ] && [ "$new_kernel" != "$run_kernel" ]; then
    ok "reboot will update kernel: $run_kernel -> $new_kernel"
  fi
  if [ "$AUTO" -eq 0 ] && [ -t 0 ]; then
    printf 'Reboot now? [y/N] '
    read -r ans
    case "$ans" in
      y|Y|yes|YES)
        pkexec systemctl reboot
        ;;
      *)
        ok "OK — reboot later with: systemctl reboot"
        ;;
    esac
  fi
else
  ok "System is up to date."
fi

log "Re-checking failed services"
failed2=$(systemctl list-units --failed --no-legend --no-pager --plain 2>/dev/null | awk 'NF {print $1}' | paste -sd ', ' -)
if [ -n "$failed2" ]; then
  warn "failed units: $failed2"
else
  ok "no failed units"
fi

if command -v notify-send >/dev/null 2>&1; then
  if [ "$FAILED" -gt 0 ]; then
    notify-send -a "System Update" -u critical "System update complete" "$FAILED step(s) failed — see the log" 2>/dev/null
  elif [ "$reboot_needed" -eq 1 ]; then
    notify-send -a "System Update" -u critical "System update complete" "A reboot is needed to apply the update" 2>/dev/null
  else
    notify-send -a "System Update" -u normal "System update complete" "Everything is up to date" 2>/dev/null
  fi
fi

end=$(date +%s)
printf 'Finished in %dm %ds\n' "$(( (end - start) / 60 ))" "$(( (end - start) % 60 ))"
if [ "$FAILED" -gt 0 ]; then
  warn "$FAILED step(s) failed — see the log for details."
fi
echo
if [ "$AUTO" -eq 0 ] && [ -t 0 ]; then
  printf 'Press Enter to close...'
  read -r _
else
  sleep 1
fi
[ "$FAILED" -gt 0 ] && exit 1 || exit 0
